# PhilCore local environment template.
# Copy to .env and fill only the values needed for the local flow you are running.
# Do not commit real keys, mnemonics, RPC credentials, or Phil secrets.

# Optional Base / bundler endpoints for live-runner experiments.
# The default local test and no-send matrix flows do not require these.
BASE_RPC_URL=
PHIL_BASE_BUNDLER_URL=
BASE_BUNDLER_RPC_URL=
SMART_ACCOUNT_DEPLOY_BUNDLER_URL=
BUNDLER_RPC_URL=

# Optional deployer key for scripts that explicitly deploy contracts.
# Leave blank unless you are intentionally running a deployment command.
DEPLOYER_PRIVATE_KEY=
PRIVATE_KEY=

# Optional local API port for future service experiments.
API_PORT=8787
